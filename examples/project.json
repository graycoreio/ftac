{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "name": "examples",
  "projectType": "application",
  "tags": [
    "type:example"
  ],
  "implicitDependencies": [
    "ftac"
  ],
  "targets": {
    "build": {
      "executor": "./lib/ftac:build",
      "options": {}
    },
    "check": {
      "executor": "./lib/ftac:build",
      "dependsOn": [
        "^typecheck",
        "^test"
      ],
      "options": {
        "check": true
      }
    },
    "decompile": {
      "executor": "./lib/ftac:decompile",
      "options": {}
    }
  }
}
