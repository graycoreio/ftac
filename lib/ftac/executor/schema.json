{
  "$schema": "https://json-schema.org/schema",
  "version": 2,
  "title": "Pipeline builds",
  "description": "Compile every *-pipeline.yaml matching the pattern.",
  "type": "object",
  "properties": {
    "check": {
      "type": "boolean",
      "description": "Verify each checked-in JSON matches its build instead of writing it.",
      "default": false
    },
    "pattern": {
      "type": "string",
      "description": "Glob for pipeline files, relative to the project root.",
      "default": "**/*-pipeline.yaml"
    }
  },
  "additionalProperties": false
}
