{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/package-lock.json"
    ],
    "ftac": [
      "{workspaceRoot}/lib/ftac/**/*.ts",
      "{workspaceRoot}/lib/ftac/tsconfig.json"
    ]
  },
  "targetDefaults": {
    "typecheck": {
      "cache": true,
      "inputs": [
        "default"
      ]
    },
    "test": {
      "cache": true,
      "inputs": [
        "default"
      ]
    },
    "check": {
      "cache": true,
      "inputs": [
        "default",
        "ftac"
      ]
    },
    "build": {
      "cache": false
    }
  },
  "analytics": false,
  "tui": {
    "enabled": false
  }
}
